<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin the package source for this repository so restore works regardless of the host's
    machine/user NuGet configuration. `<clear/>` drops any inherited (possibly empty) source
    list, then nuget.org is added explicitly.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
